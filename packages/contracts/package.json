{
  "name": "@uno/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Wire contract shared by the UNO server and client: schemas, event maps, views.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@uno/engine": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
