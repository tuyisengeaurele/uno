{
  "name": "uno",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time multiplayer UNO for the browser",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<=6.4.2": ">=6.4.3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^15",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "typescript": "^5.7",
    "typescript-eslint": "^8"
  }
}
