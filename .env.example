# Copy to .env and fill in. .env is gitignored and never committed.

# Postgres connection string used by Prisma (backend milestone).
DATABASE_URL="postgresql://uno:uno@localhost:5432/uno?schema=public"

# Redis, used for the Socket.IO adapter and shared room state when running
# more than one backend instance. Optional for single-instance local dev.
REDIS_URL="redis://localhost:6379"

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Exact origin of the deployed frontend. CORS rejects everything else.
CORS_ORIGIN="http://localhost:5173"

# Sentry DSN for backend error reporting. Leave blank to disable.
SENTRY_DSN=""

# Port the backend listens on.
PORT="3000"
